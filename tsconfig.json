{
  "compilerOptions": {
    "isolatedModules": true,
    "target": "ESNext",
    "module": "NodeNext",
    "lib": ["esnext", "dom"],
    "strict": true,
    "typeRoots": ["node_modules/@types", "./types"],
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "types": ["jest"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "**/*.spec.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "lib": ["esnext", "dom"]
}
