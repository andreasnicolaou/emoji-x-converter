{
  "name": "@andreasnicolaou/emoji-x-converter",
  "version": "1.1.0",
  "description": "A TypeScript library to convert between emojis and their textual descriptions across different languages using customizable mappings.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "format": "prettier --write .",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "format:check": "prettier --check .",
    "test:bundle": "bundlewatch",
    "generate:emoji": "node generate-emoji-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasnicolaou/emoji-x-converter.git"
  },
  "bugs": {
    "url": "https://github.com/andreasnicolaou/emoji-x-converter/issues"
  },
  "author": "Andreas Nicolaou",
  "license": "MIT",
  "jest": {
    "transform": {
      "^.+\\.(ts)$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "Bundler"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(.{1,2}/.*).js$": "$1"
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "bundlewatch": "^1.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "3.9.10",
    "rollup": "^4.65.1",
    "rollup-plugin-dts": "^6.5.1",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "emoji",
    "conversion",
    "typescript",
    "emoji-x-description",
    "emoji-x-loader",
    "language-conversion",
    "andreasnicolaou"
  ],
  "bundlewatch": {
    "files": [
      {
        "path": "dist/index.js",
        "maxSize": "700kB"
      },
      {
        "path": "dist/index.cjs",
        "maxSize": "700kB"
      },
      {
        "path": "dist/index.umd.js",
        "maxSize": "700kB"
      }
    ],
    "ci": {
      "trackBranches": [
        "main"
      ]
    }
  }
}
